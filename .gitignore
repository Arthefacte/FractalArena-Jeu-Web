
# asset source lourd (non versionné)
logo3d.src.glb

# dépendance dev-only (test de parse Babel market.jsx) — le runtime reste sans build step (Babel CDN)
node_modules/

# Design system (claude.ai/design) : les SOURCES du bundle sont versionnées,
# l'artefact de build et les assets recopiés ne le sont pas (régénérables via
# .design-sync/_tools/build.mjs + gen-cards/gen-docs/gen-readme).
ds-bundle/*
!ds-bundle/_src/

# Plans internes Claude Code — retirés du dépôt public (conservés en local + _studio)
docs/superpowers/

# Rebuts de travail locaux (jamais versionnes : .glb de bake, prototypes, sessions)
_bake/raw/
_bake/*.glb
_chips-proto.html
_jeton-test.html
_chips-check.html
_pot-check.html
_session_*.json

# Sorties de verification du bake (jetables, regenerables)
_bake/*.png
_bake/*.gif
_bake/*.webp
_bake/frames/
