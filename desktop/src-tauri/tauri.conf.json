{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fractal Arena",
  "version": "0.1.0",
  "identifier": "com.fractalarena.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Fractal Arena pour Windows",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["French"], "installMode": "currentUser" },
      "wix": { "language": "fr-FR" }
    }
  }
}
